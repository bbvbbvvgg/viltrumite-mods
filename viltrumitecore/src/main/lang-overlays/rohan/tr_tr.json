{
  "gui.viltrumitecore.race_selection.become_rohan": "Rohan Kishibe ol",
  "ability.viltrumitecore.rohan_heavens_door.name": "Heaven's Door",
  "ability.viltrumitecore.rohan_heavens_door.desc": "Stand 5 blok (mürekkep işaretiyle 9) içindeki bir bedene dokunur ve onu kitap gibi açar: gerçeği oku, talimat yaz. Tekrar basınca kitap kapanır; yakında kimse yoksa standı çağırır ya da geri gönderir. 20 mürekkep.",
  "ability.viltrumitecore.rohan_air_sketch.name": "Havaya Eskiz",
  "ability.viltrumitecore.rohan_air_sketch.desc": "Havaya Pink Dark Boy çizer (0,8 sn). 4 sn boyunca 12 blok içinde çizime bakan en fazla 4 beden kitap gibi açılır. Kör, uyuyan ve öfkeden gözü dönmüş olanlar bağışıktır. 35 mürekkep.",
  "ability.viltrumitecore.rohan_pen_nibs.name": "Kalem Uçları",
  "ability.viltrumitecore.rohan_pen_nibs.desc": "Üç G-pen ucu fırlatır (16 blok, her biri 2 hasar). İsabet 6 sn mürekkep işareti bırakır: Heaven's Door işaretli bedene 9 bloktan ulaşır. 6 mürekkep.",
  "ability.viltrumitecore.rohan_faster_than_a_punch.name": "Yumruktan Hızlı",
  "ability.viltrumitecore.rohan_faster_than_a_punch.desc": "Stand 0,6 sn açık avuçla bekler. İlk yakın dövüş vuruşu asla ulaşmaz: saldıran 2 sn kitap gibi açılır ve içine \"Rohan Kishibe'ye saldıramaz\" zaten yazılmıştır. 20 mürekkep.",
  "ability.viltrumitecore.rohan_self_edit.name": "Kendini Düzenle",
  "ability.viltrumitecore.rohan_self_edit.desc": "Stand kendi yanağına yazar: \"70 km/s hızla geriye uçar\". 10 blok geriye fırlar; yavaşlık, mide bulantısı ve tutulmayı üzerinden atar. 15 mürekkep.",
  "ability.viltrumitecore.rohan_manuscript.name": "Müsvedde",
  "ability.viltrumitecore.rohan_manuscript.desc": "Nihai yetenek (100 ilham). Bitmiş bir sayfayı kaldırır (1,5 sn): önündeki 14 blok içinde onu gören en fazla 8 beden 5 sn kitap gibi açılır. Tek satır hepsine yazılır. İlham yeni kitaplar okumaktan gelir.",
  "subtitle.viltrumitecore.speaker.rohan": "Rohan Kishibe",
