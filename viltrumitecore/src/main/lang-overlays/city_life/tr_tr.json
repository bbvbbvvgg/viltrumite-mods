  "subtitles.viltrumitecore.city_life.line.greet_1": "“Merhaba! Seni görmeyeli yıllar oldu!”",
  "subtitles.viltrumitecore.city_life.line.greet_1.f": "“Merhaba! Seni görmeyeli yıllar oldu!”",
  "subtitles.viltrumitecore.city_life.line.greet_2": "“Merhaba! Hep iş, biliyorsun.”",
  "subtitles.viltrumitecore.city_life.line.greet_3": "“Kaybolma ama. Görüşürüz!”",
  "subtitles.viltrumitecore.city_life.line.weather_1": "“Bugün hava ne güzel, değil mi?”",
  "subtitles.viltrumitecore.city_life.line.weather_2": "“Evet, nihayet güneş. Yürüyüş için harika.”",
  "subtitles.viltrumitecore.city_life.line.market_1": "“Pazara mı? Taze ekmek gelmiş diyorlar.”",
  "subtitles.viltrumitecore.city_life.line.market_2": "“Tam oraya gidiyorum. Sana da ekmek alayım mı?”",
  "subtitles.viltrumitecore.city_life.line.market_3": "“Evet, lütfen. Teşekkürler!”",
  "subtitles.viltrumitecore.city_life.line.heroes_1": "“Duydun mu? Meydanın üstünde yine biri uçmuş.”",
  "subtitles.viltrumitecore.city_life.line.heroes_2": "“Evet. İnşallah bu sefer bir yer yıkılmaz.”",
  "subtitles.viltrumitecore.city_life.line.heroes_3": "“Sorma. Geçen seferki camlar hâlâ değişiyor.”",
  "subtitles.viltrumitecore.city_life.line.work_1": "“Yeni iş nasıl?”",
  "subtitles.viltrumitecore.city_life.line.work_2": "“Alışıyorum yavaş yavaş. Patron sert ama adil.”",
  "subtitles.viltrumitecore.city_life.line.work_3": "“Önemli olan sevmen.”",
  "subtitles.viltrumitecore.city_life.line.lunch_1": "“Yemeğe gidelim mi? Yakında bir kafe açılmış.”",
  "subtitles.viltrumitecore.city_life.line.lunch_2": "“Olur. Ama kısa, saat ikide toplantım var.”",
  "subtitles.viltrumitecore.city_life.line.way_1": "“Affedersiniz, istasyona nasıl giderim?”",
  "subtitles.viltrumitecore.city_life.line.way_2": "“Kavşağa kadar düz, sonra sola. Beş dakika.”",
  "subtitles.viltrumitecore.city_life.line.way_3": "“Çok teşekkürler!”",
  "subtitles.viltrumitecore.city_life.line.kids_1": "“Çocuklar nasıl?”",
  "subtitles.viltrumitecore.city_life.line.kids_2": "“Büyüyorlar! Küçük bu yıl okula başladı.”",
  "subtitles.viltrumitecore.city_life.line.kids_3": "“Vay! Zaman nasıl da geçiyor.”",
  "subtitles.viltrumitecore.city_life.line.match_1": "“Dünkü maç nasıldı sence?”",
  "subtitles.viltrumitecore.city_life.line.match_2": "“Son dakika tam bir mucizeydi!”",
  "subtitles.viltrumitecore.city_life.line.match_3": "“Bütün mahalle bağırıyordu. Neredeyse kanepeden düşüyordum!”",
  "subtitles.viltrumitecore.city_life.line.match_3.f": "“Bütün mahalle bağırıyordu. Neredeyse kanepeden düşüyordum!”",
  "subtitles.viltrumitecore.city_life.line.tower_1": "“Bak, o kuleye yine iskele kurmuşlar.”",
  "subtitles.viltrumitecore.city_life.line.tower_2": "“Tamirat herhalde. Bir türlü bitiremiyorlar.”",
  "subtitles.viltrumitecore.city_life.line.phone_1": "“Baksana, telefonum nerede? Hiçbir yerde bulamıyorum.”",
  "subtitles.viltrumitecore.city_life.line.phone_2": "“Elinde.”",
  "subtitles.viltrumitecore.city_life.line.phone_3": "“Ay... Doğru. Sağ ol.”",
  "subtitles.viltrumitecore.city_life.line.prices_1": "“Fiyatlar yine artmış. Yakında ekmeğe bile yetmeyecek.”",
  "subtitles.viltrumitecore.city_life.line.prices_2": "“Sorma. Hiç değilse maaşlara zam sözü var.”",
  "subtitles.viltrumitecore.city_life.line.tourist_1": "“Ne güzel bir şehir! İlk kez geliyorum.”",
  "subtitles.viltrumitecore.city_life.line.tourist_2": "“Hoş geldiniz! Ana meydana mutlaka uğrayın.”",
  "subtitles.viltrumitecore.city_life.line.morning_1": "“Günaydın! Bugün erkencisin.”",
  "subtitles.viltrumitecore.city_life.line.morning_2": "“Günaydın! Öğleden önce her şeyi bitirmek istiyorum.”",
  "subtitles.viltrumitecore.city_life.line.evening_1": "“Geç oldu, eve dönme vakti.”",
  "subtitles.viltrumitecore.city_life.line.evening_2": "“Evet, yarın erken kalkacağım. İyi geceler!”",
  "subtitles.viltrumitecore.city_life.line.rain_1": "“Yine bu yağmur. Sırılsıklam olacağız.”",
  "subtitles.viltrumitecore.city_life.line.rain_2": "“Hadi, saçağın altına!”",
  "subtitles.viltrumitecore.city_life.line.hear_1": "“Duyuyor musun? Yine gümbürdüyor.”",
  "subtitles.viltrumitecore.city_life.line.hear_2": "“Uzaklarda bir yerde. En iyisi uzak duralım.”",
  "subtitles.viltrumitecore.city_life.line.uneasy_1": "“Burada içim rahat değil.”",
  "subtitles.viltrumitecore.city_life.line.uneasy_2": "“Benim de. Gidelim buradan.”",
  "subtitles.viltrumitecore.city_life.line.news_1": "“Radyoda evden çıkmayın dediler.”",
  "subtitles.viltrumitecore.city_life.line.news_2": "“Ben de sadece ekmek almaya çıkmıştım...”",
  "subtitles.viltrumitecore.city_life.line.okay_1": "“Nasılsın? İyi misin?”",
  "subtitles.viltrumitecore.city_life.line.okay_2": "“Sanırım... Sadece ellerim titriyor.”",
  "subtitles.viltrumitecore.city_life.line.okay_3": "“Dayan. Önemli olan hayatta olmamız.”",
  "subtitles.viltrumitecore.city_life.line.what_1": "“O da neydi öyle?”",
  "subtitles.viltrumitecore.city_life.line.what_2": "“Bilmiyorum. Hiç böyle bir şey görmedim.”",
  "subtitles.viltrumitecore.city_life.line.what_2.f": "“Bilmiyorum. Hiç böyle bir şey görmedim.”",
  "subtitles.viltrumitecore.city_life.line.home_1": "“Evim tam oradaydı...”",
  "subtitles.viltrumitecore.city_life.line.home_2": "“Gel. Burada kalmak tehlikeli.”",
  "subtitles.viltrumitecore.city_life.line.rescue_1": "“Kurtarma ekibini arayan oldu mu?”",
  "subtitles.viltrumitecore.city_life.line.rescue_2": "“Arıyorum arıyorum, hat hep meşgul.”",
  "subtitles.viltrumitecore.city_life.line.where_1": "“Herkes nereye koştu?”",
  "subtitles.viltrumitecore.city_life.line.where_2": "“Meydana. Orası daha güvenli galiba.”",
  "subtitles.viltrumitecore.city_life.line.rubble_1": "“Enkazı kaldırmama yardım et, içeride biri var!”",
  "subtitles.viltrumitecore.city_life.line.rubble_2": "“Geliyorum! Dikkat, her şey sallanıyor.”",
  "subtitles.viltrumitecore.city_life.line.startle_1": "“Bu ne?!”",
  "subtitles.viltrumitecore.city_life.line.startle_2": "“Bakın! Orada, yukarıda!”",
  "subtitles.viltrumitecore.city_life.line.startle_3": "“Aman Allahım...”",
  "subtitles.viltrumitecore.city_life.line.flee_1": "“Kaçın!”",
  "subtitles.viltrumitecore.city_life.line.flee_2": "“Herkes siper alsın!”",
  "subtitles.viltrumitecore.city_life.line.flee_3": "“Buraya, çabuk!”",
  "subtitles.viltrumitecore.city_life.line.flee_4": "“Dikkat!”",
  "subtitles.viltrumitecore.city_life.line.flee_5": "“İtmeyin!”",
  "subtitles.viltrumitecore.city_life.line.help_1": "“İmdat!”",
  "subtitles.viltrumitecore.city_life.line.help_2": "“Biri yardım etsin!”",
  "subtitles.viltrumitecore.city_life.line.help_3": "“İmdat, kalkamıyorum!”",
  "subtitles.viltrumitecore.city_life.line.help_4": "“Anne! Neredesin?”",
  "subtitles.viltrumitecore.city_life.line.survivor_1": "“Yaşayan var mı?”",
  "subtitles.viltrumitecore.city_life.line.survivor_2": "“Buraya! Burada yaralı var!”"
}